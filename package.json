{
    "name": "digital-picture",
    "author": "e-masque interactice",
    "description": "Digital picture frame application, configure directories and the application will play all the images within the chosen directories at the speed you choose.",
    "version": "2.0.0",
    "main": "main.js",
    "scripts": {
        "ng": "ng",
        "start": "electron-forge start",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "electron": "electron .",
        "electron-build": "ng build -c production && electron .",
        "package": "ng build -c production && electron-forge package",
        "make": "ng build -c production && electron-forge make"
    },
    "private": true,
    "dependencies": {
        "electron-squirrel-startup": "^1.0.1",
        "exif": "^0.6.0",
        "image-size": "^2.0.2"
    },
